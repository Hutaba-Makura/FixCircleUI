{
    "manifest_version": 3,
    "name": "Fix Circle UI - コミケWebカタログのUIを改善",
    "version": "1.2",
    "description": "コミックマーケットのWebカタログのUIを改善します。",
    "content_scripts": [
      {
        "matches": [
          "https://webcatalog.circle.ms/User/Favorites*",
          "https://webcatalog.circle.ms/Circle/List*",
          "https://classic-webcatalog.circle.ms/User/Favorites*",
          "https://classic-webcatalog.circle.ms/Circle/List*"
        ],
        "js": ["utils.js", "color-filter.js", "link-replacer.js"],
        "run_at": "document_idle"
      },
      {
        "matches": [
          "https://webcatalog.circle.ms/Map*",
          "https://classic-webcatalog.circle.ms/Map*"
        ],
        "js": ["map-interceptor.js"],
        "run_at": "document_start",
        "world": "MAIN"
      },
      {
        "matches": [
          "https://webcatalog.circle.ms/Map*",
          "https://classic-webcatalog.circle.ms/Map*"
        ],
        "js": ["utils.js", "map-color-filter.js", "map-link-replacer.js"],
        "run_at": "document_idle"
      }
    ],
    "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
